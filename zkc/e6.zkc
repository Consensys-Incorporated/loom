// E6 arithmetic over KoalaBear, matching gnark-crypto's field/koalabear/extensions:
//
//     E2 = F_p[u] / (u^2 - 3)
//     E6 = E2[v]  / (v^3 - ξ),  ξ = u + 1
//
// An element is passed as six 𝔽 values (b0a0, b0a1, b1a0, b1a1, b2a0, b2a1),
// i.e. B0.A0, B0.A1, B1.A0, B1.A1, B2.A0, B2.A1. All functions are inlined:
// they expand into degree-2 constraints of their caller, except e6_mul when
// declared #[native] (see E6Source).

#[inline]
fn e6_add(x0:𝔽, x1:𝔽, x2:𝔽, x3:𝔽, x4:𝔽, x5:𝔽, y0:𝔽, y1:𝔽, y2:𝔽, y3:𝔽, y4:𝔽, y5:𝔽)
        -> (z0:𝔽, z1:𝔽, z2:𝔽, z3:𝔽, z4:𝔽, z5:𝔽) {
    z0 = x0 + y0
    z1 = x1 + y1
    z2 = x2 + y2
    z3 = x3 + y3
    z4 = x4 + y4
    z5 = x5 + y5
}

#[inline]
fn e6_sub(x0:𝔽, x1:𝔽, x2:𝔽, x3:𝔽, x4:𝔽, x5:𝔽, y0:𝔽, y1:𝔽, y2:𝔽, y3:𝔽, y4:𝔽, y5:𝔽)
        -> (z0:𝔽, z1:𝔽, z2:𝔽, z3:𝔽, z4:𝔽, z5:𝔽) {
    z0 = x0 - y0
    z1 = x1 - y1
    z2 = x2 - y2
    z3 = x3 - y3
    z4 = x4 - y4
    z5 = x5 - y5
}

// e6_mul_base multiplies an E6 element by a base-field element.
#[inline]
fn e6_mul_base(x0:𝔽, x1:𝔽, x2:𝔽, x3:𝔽, x4:𝔽, x5:𝔽, c:𝔽)
        -> (z0:𝔽, z1:𝔽, z2:𝔽, z3:𝔽, z4:𝔽, z5:𝔽) {
    z0 = x0 * c
    z1 = x1 * c
    z2 = x2 * c
    z3 = x3 * c
    z4 = x4 * c
    z5 = x5 * c
}

// e6_mul is schoolbook multiplication over E2:
//
//     c0 = a0·b0 + ξ·(a1·b2 + a2·b1)
//     c1 = a0·b1 + a1·b0 + ξ·(a2·b2)
//     c2 = a0·b2 + a1·b1 + a2·b0
//
// with (p + q·u)(r + s·u) = (p·r + 3·q·s) + (p·s + q·r)·u and
// ξ·(p + q·u) = (p + 3·q) + (p + q)·u.
#[inline]
fn e6_mul(x0:𝔽, x1:𝔽, x2:𝔽, x3:𝔽, x4:𝔽, x5:𝔽, y0:𝔽, y1:𝔽, y2:𝔽, y3:𝔽, y4:𝔽, y5:𝔽)
        -> (z0:𝔽, z1:𝔽, z2:𝔽, z3:𝔽, z4:𝔽, z5:𝔽) {
    // E2 products a_i·b_j, as (real, u) parts
    var p00r:𝔽 = (x0 * y0) + (3 * (x1 * y1))
    var p00u:𝔽 = (x0 * y1) + (x1 * y0)
    var p01r:𝔽 = (x0 * y2) + (3 * (x1 * y3))
    var p01u:𝔽 = (x0 * y3) + (x1 * y2)
    var p02r:𝔽 = (x0 * y4) + (3 * (x1 * y5))
    var p02u:𝔽 = (x0 * y5) + (x1 * y4)
    var p10r:𝔽 = (x2 * y0) + (3 * (x3 * y1))
    var p10u:𝔽 = (x2 * y1) + (x3 * y0)
    var p11r:𝔽 = (x2 * y2) + (3 * (x3 * y3))
    var p11u:𝔽 = (x2 * y3) + (x3 * y2)
    var p12r:𝔽 = (x2 * y4) + (3 * (x3 * y5))
    var p12u:𝔽 = (x2 * y5) + (x3 * y4)
    var p20r:𝔽 = (x4 * y0) + (3 * (x5 * y1))
    var p20u:𝔽 = (x4 * y1) + (x5 * y0)
    var p21r:𝔽 = (x4 * y2) + (3 * (x5 * y3))
    var p21u:𝔽 = (x4 * y3) + (x5 * y2)
    var p22r:𝔽 = (x4 * y4) + (3 * (x5 * y5))
    var p22u:𝔽 = (x4 * y5) + (x5 * y4)
    // t = a1·b2 + a2·b1, then ξ·t
    var tr:𝔽 = p12r + p21r
    var tu:𝔽 = p12u + p21u
    z0 = p00r + (tr + (3 * tu))
    z1 = p00u + (tr + tu)
    // ξ·(a2·b2)
    z2 = (p01r + p10r) + (p22r + (3 * p22u))
    z3 = (p01u + p10u) + (p22r + p22u)
    z4 = (p02r + p11r) + p20r
    z5 = (p02u + p11u) + p20u
}

// e6_assert_inv fails unless x·y = 1.
fn e6_assert_inv(x0:𝔽, x1:𝔽, x2:𝔽, x3:𝔽, x4:𝔽, x5:𝔽, y0:𝔽, y1:𝔽, y2:𝔽, y3:𝔽, y4:𝔽, y5:𝔽) {
    var z0:𝔽, z1:𝔽, z2:𝔽, z3:𝔽, z4:𝔽, z5:𝔽
    z0, z1, z2, z3, z4, z5 = e6_mul(x0, x1, x2, x3, x4, x5, y0, y1, y2, y3, y4, y5)
    if z0 != 1 { fail }
    if z1 != 0 { fail }
    if z2 != 0 { fail }
    if z3 != 0 { fail }
    if z4 != 0 { fail }
    if z5 != 0 { fail }
}
