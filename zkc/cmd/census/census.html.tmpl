<title>zkc Verifier Column Census</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Condensed:wght@500;600&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap">
<style>
:root {
  --bg: #f5f6f3;
  --surface: #ffffff;
  --ink: #1c2230;
  --ink-2: #4b5462;
  --ink-3: #737b86;
  --rule: #d6dad4;
  --rule-soft: #e7eae5;
  --accent: #1f6f8b;
  --accent-soft: #e2eef2;
  --c-logic: #1f6f8b;
  --c-memory: #6b7f3a;
  --c-sponge: #7a5ba6;
  --c-native: #b0612a;
  --c-gadget: #d49a3a;
  --c-range: #8c929b;
  --sans: "IBM Plex Sans", "Helvetica Neue", Arial, sans-serif;
  --cond: "IBM Plex Sans Condensed", "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --bg: #15181d;
    --surface: #1c2027;
    --ink: #e2e5e8;
    --ink-2: #b3b9c2;
    --ink-3: #8a919c;
    --rule: #2d333b;
    --rule-soft: #242930;
    --accent: #62b4cc;
    --accent-soft: #1d3139;
    --c-logic: #4ea3c0;
    --c-memory: #93aa55;
    --c-sponge: #a488cf;
    --c-native: #d98450;
    --c-gadget: #e5b45a;
    --c-range: #8f96a0;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --bg: #15181d;
  --surface: #1c2027;
  --ink: #e2e5e8;
  --ink-2: #b3b9c2;
  --ink-3: #8a919c;
  --rule: #2d333b;
  --rule-soft: #242930;
  --accent: #62b4cc;
  --accent-soft: #1d3139;
  --c-logic: #4ea3c0;
  --c-memory: #93aa55;
  --c-sponge: #a488cf;
  --c-native: #d98450;
  --c-gadget: #e5b45a;
  --c-range: #8f96a0;
}

body {
  background: var(--bg);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 15px;
  line-height: 1.55;
  padding-inline: 20px;
  padding-block: 40px 64px;
}
.wrap { max-width: 1080px; margin-inline: auto; display: flex; flex-direction: column; gap: 44px; }
h1, h2, h3 { font-family: var(--cond); font-weight: 600; text-wrap: balance; margin: 0; line-height: 1.2; }
h1 { font-size: 34px; letter-spacing: -0.01em; }
h2 { font-size: 22px; }
h3 { font-size: 16px; }
p { margin: 0; max-width: 68ch; }
.lede { color: var(--ink-2); font-size: 16.5px; }
.eyebrow {
  font-family: var(--mono); font-size: 12px; text-transform: uppercase;
  letter-spacing: 0.08em; color: var(--accent);
}
section { display: flex; flex-direction: column; gap: 16px; }
header { display: flex; flex-direction: column; gap: 14px; }
code, .mono { font-family: var(--mono); font-size: 0.92em; }
.num { font-family: var(--mono); font-variant-numeric: tabular-nums; }

.defs { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 12px 28px; margin: 0; }
.defs div { display: flex; flex-direction: column; gap: 3px; border-top: 1px solid var(--rule); padding-top: 10px; }
.defs dt { font-weight: 600; font-size: 14px; }
.defs dd { margin: 0; color: var(--ink-2); font-size: 14px; }

.table-scroll { overflow-x: auto; border: 1px solid var(--rule); border-radius: 6px; background: var(--surface); }
table { border-collapse: collapse; width: 100%; font-size: 13.5px; }
th, td { padding: 8px 12px; text-align: right; white-space: nowrap; border-bottom: 1px solid var(--rule-soft); }
th:first-child, td:first-child { text-align: left; }
th {
  font-family: var(--mono); font-weight: 500; font-size: 11.5px; text-transform: uppercase;
  letter-spacing: 0.06em; color: var(--ink-3); background: var(--bg); position: sticky; top: 0;
}
td { font-family: var(--mono); font-variant-numeric: tabular-nums; }
td.name { font-family: var(--mono); }
td.label { font-family: var(--sans); }
tbody tr:last-child td { border-bottom: none; }
tfoot td { border-top: 1px solid var(--rule); border-bottom: none; font-weight: 500; }
tr.sel td { background: var(--accent-soft); }
tr.clickable { cursor: pointer; }
tr.clickable:hover td { background: var(--accent-soft); }

.bar { display: flex; height: 12px; width: 220px; border-radius: 2px; overflow: hidden; background: var(--rule-soft); }
.bar span { display: block; height: 100%; }
.legend { display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 13px; color: var(--ink-2); }
.legend span { display: inline-flex; align-items: center; gap: 7px; }
.sw { width: 11px; height: 11px; border-radius: 2px; display: inline-block; flex: none; }

.kind { display: inline-flex; align-items: center; gap: 7px; font-family: var(--sans); font-size: 13px; color: var(--ink-2); }
.share { display: inline-flex; align-items: center; gap: 8px; justify-content: flex-end; }
.share i { display: inline-block; height: 7px; background: var(--accent); border-radius: 1px; }

.picker { display: flex; flex-wrap: wrap; gap: 8px; }
.picker button {
  font-family: var(--mono); font-size: 12.5px; color: var(--ink-2);
  background: var(--surface); border: 1px solid var(--rule); border-radius: 4px;
  padding: 6px 10px; cursor: pointer;
}
.picker button[aria-pressed="true"] { color: var(--bg); background: var(--accent); border-color: var(--accent); }
.picker button:focus-visible, tr.clickable:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

.facts { display: flex; flex-wrap: wrap; gap: 10px 32px; font-size: 14px; color: var(--ink-2); }
.facts b { color: var(--ink); font-family: var(--mono); font-weight: 500; font-variant-numeric: tabular-nums; }

.natives { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px; }
.native { background: var(--surface); border: 1px solid var(--rule); border-radius: 6px; padding: 16px 18px; display: flex; flex-direction: column; gap: 8px; }
.native h3 { font-family: var(--mono); font-weight: 500; font-size: 15px; }
.native p { font-size: 14px; color: var(--ink-2); }
.native dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 3px 14px; font-size: 13.5px; }
.native dt { color: var(--ink-3); }
.native dd { margin: 0; font-family: var(--mono); font-variant-numeric: tabular-nums; }

ul.plain { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 6px; max-width: 72ch; color: var(--ink-2); }
ul.plain li::marker { color: var(--ink-3); }
.note { font-size: 13.5px; color: var(--ink-3); }

@media (max-width: 560px) {
  h1 { font-size: 27px; }
  .bar { width: 140px; }
}
</style>

<div class="wrap">
  <header>
    <span class="eyebrow">loom · zkc recursion prototype</span>
    <h1>zkc Verifier Column Census</h1>
    <p class="lede">
      Where the columns go when loom's PCS verifier (<code>fri.PCS.Verify</code>: transcript, FRI,
      batch openings and the DEEP bridge) is written in zkc and proven by loom. For recursion, the number
      that matters is the width: a loom proof of this circuit opens one row of every committed column at
      each FRI query, and the next verifier has to hash those rows.
    </p>
    <dl class="defs">
      <div><dt>Committed columns</dt><dd>Every polynomial loom commits: zkc trace columns kept by the bridge, gadget columns, setup columns, logup running sums, lookup multiplicities and AIR-quotient chunks.</dd></div>
      <div><dt>Leaf elements per query</dt><dd>Field elements the next verifier hashes per query: 2 per base column (the row pair f(X), f(−X)) and 12 per extension column.</dd></div>
      <div><dt>Leaf permutations per query</dt><dd>Poseidon2 permutations to hash those leaves, one sponge per (tree, group). Compare with the verifier's own permutations per query.</dd></div>
      <div><dt>Setting</dt><dd>KoalaBear with E6 extension, RATE = 4, 32 FRI queries, width-24 Poseidon2. Counts are taken after tracing each shape; the tests prove and verify the verifier end to end on a smaller shape.</dd></div>
    </dl>
  </header>

  <section>
    <h2>All shapes</h2>
    <p>Each shape is a set of committed polynomial groups (size 2<sup>logN</sup>, number of polynomials, opened at shifts 0 and 1). Select a row to see its modules below.</p>
    <div class="legend" id="legend"></div>
    <div class="table-scroll">
      <table id="summary">
        <thead><tr>
          <th>Shape</th><th>Groups</th><th>Verifier perms</th><th>Perms / query</th>
          <th>Committed columns</th><th>Leaf elements / query</th><th>Leaf perms / query</th><th>Leaf elements by module kind</th>
        </tr></thead>
        <tbody></tbody>
      </table>
    </div>
    <p class="note">Leaf permutations per query versus the verifier's own permutations per query is the recursion imbalance: at 16 polynomials, about 1,080 against 89 today.</p>
  </section>

  <section>
    <h2>Modules of one shape</h2>
    <div class="picker" id="picker" role="group" aria-label="Shape"></div>
    <div class="facts" id="facts"></div>
    <div class="table-scroll">
      <table id="modules">
        <thead><tr>
          <th>Module</th><th>Kind</th><th>Rows</th><th>Trace</th><th>Setup</th>
          <th>Logup (E6)</th><th>Mult</th><th>Quotient (E6)</th><th>Leaf elements / query</th><th>Share</th>
        </tr></thead>
        <tbody></tbody>
        <tfoot></tfoot>
      </table>
    </div>
    <p class="note">Rows are padded to a power of two (at least 4). Trace counts base columns; the verifier has no extension trace columns besides logups and quotient chunks.</p>
  </section>

  <section>
    <h2>Native functions</h2>
    <p>
      Three kinds of zkc functions are declared <code>#[native]</code>. zkc executes their body to produce the
      witness but emits no constraints for them; the loom bridge keeps only their input and output columns
      and a Go gadget supplies the constraints. Every call site is a lookup into the native module.
    </p>
    <div class="natives">
      <article class="native">
        <h3>p2_perm</h3>
        <p>Poseidon2 permutation, width 24, x³ S-box, 6 full and 21 partial rounds. Used by every hash: leaves, Merkle nodes, the transcript.</p>
        <dl>
          <dt>Gadget</dt><dd>Poseidon2Gadget</dd>
          <dt>Layout</dt><dd>1 row per permutation</dd>
          <dt>Columns</dt><dd>189 (was 2,123 in zkc)</dd>
          <dt>Degree</dt><dd>3</dd>
        </dl>
      </article>
      <article class="native">
        <h3>e6_mul</h3>
        <p>Multiplication in the degree-6 extension, schoolbook over E2 (u² = 3, v³ = u + 1).</p>
        <dl>
          <dt>Gadget</dt><dd>E6MulGadget</dd>
          <dt>Layout</dt><dd>1 row per multiplication</dd>
          <dt>Columns</dt><dd>18 (caller pays 6 instead of 81)</dd>
          <dt>Degree</dt><dd>2</dd>
        </dl>
      </article>
      <article class="native">
        <h3>open_&lt;b&gt;_&lt;g&gt;</h3>
        <p>One per committed (batch, group). For one query it returns the leaf digest of the group's opened row pair and the DEEP sums G<sub>set</sub>(±X) = Σ α<sup>i</sup>·f<sub>i</sub>(±X) per shift set.</p>
        <dl>
          <dt>Gadget</dt><dd>OpeningGadget</dd>
          <dt>Modules</dt><dd>I/O + _items + _sponge</dd>
          <dt>_items</dt><dd>1 row per (query, side, polynomial)</dd>
          <dt>_sponge</dt><dd>1 row per 16-element leaf block</dd>
          <dt>Degree</dt><dd>≤ 4</dd>
        </dl>
      </article>
    </div>
    <p>
      Everything else is ordinary zkc: <code>main</code> (transcript, claimed values, DEEP sums V<sub>s</sub>),
      <code>pcs_query</code> (one row per query: FRI layers, Merkle paths, folding, DEEP combination),
      <code>merkle_step</code>, <code>p2_node</code>, the generated <code>sponge_L</code> /
      <code>sponge_absorb</code> / <code>sponge_squeeze_R</code>, the row readers <code>ld8</code> and
      <code>ldroot</code>, and the assertions <code>assert_eq</code>, <code>assert_eq6</code>,
      <code>assert_eq8</code>, <code>e6_assert_inv</code>. The E6 helpers <code>e6_add</code>,
      <code>e6_sub</code> and <code>e6_mul_base</code> are <code>#[inline]</code> and have no module.
    </p>
  </section>

  <section>
    <h2>How the numbers were produced</h2>
    <ul class="plain">
      <li>Each shape is a random commitment with loom's PCS, opened and checked by the Go verifier first; the zkc verifier is generated from its shape.</li>
      <li>zkc v1.2.32 compiles the program; the loom bridge translates its AIR. Lookups sharing a target are proven as one union lookup; source logups are batched by up to 3 per column (degree 4).</li>
      <li>Counts are taken from the compiled loom program and its canonical commitment layout, after tracing. They are exact for these shapes.</li>
      <li>What still grows with the number of polynomials lives in <code>main</code> and its wide <code>sponge_L</code> (absorbing the claimed values). What grows with log N is mostly the Merkle paths in <code>pcs_query</code>.</li>
    </ul>
  </section>
</div>

<script>
const DATA = __DATA__;

const KINDS = [
  { key: "logic",  label: "Verifier logic",   color: "var(--c-logic)" },
  { key: "memory", label: "Proof memory",     color: "var(--c-memory)" },
  { key: "sponge", label: "Sponge helpers",   color: "var(--c-sponge)" },
  { key: "native", label: "Native I/O",       color: "var(--c-native)" },
  { key: "gadget", label: "Gadget internals", color: "var(--c-gadget)" },
  { key: "range",  label: "zkc range tables", color: "var(--c-range)" },
];
const kindOf = (name) => {
  if (name.startsWith("$")) return "range";
  if (/^open_\d+_\d+_(items|sponge)$/.test(name)) return "gadget";
  if (name === "p2_perm" || name === "e6_mul" || /^open_\d+_\d+$/.test(name)) return "native";
  if (name.startsWith("sponge_")) return "sponge";
  if (["p_in", "p_roots", "ld8", "ldroot"].includes(name)) return "memory";
  return "logic";
};
const kindInfo = Object.fromEntries(KINDS.map(k => [k.key, k]));
const fmt = (n) => n.toLocaleString("en-US");
const cols = (m) => m.trace + m.traceExt + m.setup + m.logup + m.mult + m.quotient;
const groupsText = (c) => c.groups.map(g => `2^${g.LogN}×${g.NumBase + g.NumExt}`).join(", ");

function el(tag, attrs = {}, ...children) {
  const e = document.createElement(tag);
  for (const [k, v] of Object.entries(attrs)) {
    if (k === "class") e.className = v; else if (k === "style") e.style.cssText = v; else e.setAttribute(k, v);
  }
  for (const c of children) e.append(c);
  return e;
}

function kindBar(c) {
  const total = c.modules.reduce((s, m) => s + m.leaf, 0);
  const by = {};
  for (const m of c.modules) { const k = kindOf(m.name); by[k] = (by[k] || 0) + m.leaf; }
  const bar = el("div", { class: "bar", role: "img",
    "aria-label": KINDS.filter(k => by[k.key]).map(k => `${k.label} ${Math.round(100 * by[k.key] / total)}%`).join(", ") });
  for (const k of KINDS) {
    if (!by[k.key]) continue;
    bar.append(el("span", { style: `width:${(100 * by[k.key] / total).toFixed(2)}%;background:${k.color}`,
      title: `${k.label}: ${fmt(by[k.key])} (${Math.round(100 * by[k.key] / total)}%)` }));
  }
  return bar;
}

const legend = document.getElementById("legend");
for (const k of KINDS) legend.append(el("span", {}, el("i", { class: "sw", style: `background:${k.color}` }), k.label));

let selected = 1;
const summary = document.querySelector("#summary tbody");
const picker = document.getElementById("picker");

DATA.forEach((c, i) => {
  const tr = el("tr", { class: "clickable", tabindex: "0", "data-i": i },
    el("td", { class: "label" }, c.name),
    el("td", {}, groupsText(c)),
    el("td", {}, fmt(c.perms)),
    el("td", {}, fmt(c.permsPerQuery)),
    el("td", {}, fmt(c.modules.reduce((s, m) => s + cols(m), 0))),
    el("td", {}, fmt(c.leafElems)),
    el("td", {}, fmt(c.leafPerms)),
    el("td", {}, kindBar(c)));
  tr.addEventListener("click", () => select(i));
  tr.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); select(i); } });
  summary.append(tr);
  const b = el("button", { type: "button", id: `shape-${i}`, "aria-pressed": "false" }, c.name);
  b.addEventListener("click", () => select(i));
  picker.append(b);
});

function select(i) {
  selected = i;
  document.querySelectorAll("#summary tbody tr").forEach((tr, j) => tr.classList.toggle("sel", j === i));
  picker.querySelectorAll("button").forEach((b, j) => b.setAttribute("aria-pressed", String(j === i)));
  const c = DATA[i];
  const total = c.modules.reduce((s, m) => s + m.leaf, 0);
  const totalCols = c.modules.reduce((s, m) => s + cols(m), 0);
  const facts = document.getElementById("facts");
  facts.replaceChildren(
    el("span", {}, "Groups ", el("b", {}, groupsText(c))),
    el("span", {}, "Modules ", el("b", {}, String(c.modules.length))),
    el("span", {}, "Committed columns ", el("b", {}, fmt(totalCols))),
    el("span", {}, "Leaf elements / query ", el("b", {}, fmt(total))),
    el("span", {}, "Leaf perms / query ", el("b", {}, fmt(c.leafPerms))),
    el("span", {}, "Verifier perms / query ", el("b", {}, fmt(c.permsPerQuery))));
  const max = Math.max(...c.modules.map(m => m.leaf));
  const tbody = document.querySelector("#modules tbody");
  tbody.replaceChildren(...c.modules.map(m => {
    const k = kindInfo[kindOf(m.name)];
    const pct = 100 * m.leaf / total;
    return el("tr", {},
      el("td", { class: "name" }, m.name),
      el("td", {}, el("span", { class: "kind" }, el("i", { class: "sw", style: `background:${k.color}` }), k.label)),
      el("td", {}, fmt(m.rows)),
      el("td", {}, fmt(m.trace + m.traceExt)),
      el("td", {}, m.setup ? fmt(m.setup) : "–"),
      el("td", {}, fmt(m.logup)),
      el("td", {}, fmt(m.mult)),
      el("td", {}, fmt(m.quotient)),
      el("td", {}, fmt(m.leaf)),
      el("td", {}, el("span", { class: "share" }, el("i", { style: `width:${(60 * m.leaf / max).toFixed(1)}px` }), `${pct.toFixed(1)}%`)));
  }));
  const sum = (f) => c.modules.reduce((s, m) => s + f(m), 0);
  document.querySelector("#modules tfoot").replaceChildren(el("tr", {},
    el("td", { class: "label" }, "Total"), el("td", {}, ""), el("td", {}, ""),
    el("td", {}, fmt(sum(m => m.trace + m.traceExt))), el("td", {}, fmt(sum(m => m.setup))),
    el("td", {}, fmt(sum(m => m.logup))), el("td", {}, fmt(sum(m => m.mult))),
    el("td", {}, fmt(sum(m => m.quotient))), el("td", {}, fmt(total)), el("td", {}, "100%")));
}
select(selected);
</script>
